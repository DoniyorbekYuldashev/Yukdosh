# ── Sarbon24 environment (copy to .env and fill in) ─────────────────────────────
# Never commit the real .env — it holds secrets. .env is already in .gitignore.

# Database. For full Docker deployment, leave DATABASE_URL unset here (compose sets it
# to the internal Postgres). For local `python run_all.py` dev, point it at your DB:
#   DATABASE_URL=postgresql+asyncpg://sarbon:sarbon@localhost:5432/sarbon
#   DATABASE_URL=sqlite+aiosqlite:///./sarbon.db
POSTGRES_USER=sarbon
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=sarbon

# Web admin login — REQUIRED in production. If ADMIN_PASSWORD is empty, the admin is OPEN.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Public domain for the admin site (A record -> your server). Caddy issues HTTPS for it.
DOMAIN=admin.example.com

# Driver bot — REQUIRED to run the bot. From @BotFather (/newbot).
BOT_TOKEN=

# LLM parser keys (set the one you use; can also be set in the Settings UI).
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Real Telegram scraping — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
