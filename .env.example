# ── Yukdosh server environment ─────────────────────────────────────────────────
# Copy to .env on the server and fill in. NEVER commit .env (it's in .gitignore).

# Database — mode 1 (default): Postgres container on this server.
# Pick a long random password:  openssl rand -hex 24
COMPOSE_PROFILES=localdb
POSTGRES_USER=yukdosh
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password
POSTGRES_DB=yukdosh

# Database — mode 2: hosted Postgres (Supabase). Delete the 4 lines above and set:
#   Supabase → project → Connect → "Session pooler" URI (IPv4; keeps prepared statements).
#   Special chars in the password must be URL-encoded: @ = %40, # = %23
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Web admin login — REQUIRED on a server.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_long_random_admin_password

# Driver bot — from @BotFather
BOT_TOKEN=

# Parser — OpenAI (data-sharing free tier applies automatically to this key's project)
OPENAI_API_KEY=

# Telegram scraping userbot — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Optional: only if you later add a domain + HTTPS (docker compose --profile https up -d)
# DOMAIN=admin.yukdosh.uz
